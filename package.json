{
	"name": "@puffinstudio/fizzyx",
	"version": "0.5.4",
	"homepage": "https://github.com/PuffinStudio/fizzyx#readme",
	"bugs": {
		"url": "https://github.com/PuffinStudio/fizzyx/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/PuffinStudio/fizzyx.git"
	},
	"bin": {
		"fizzyx": "dist/main.js"
	},
	"files": [
		"dist/main.js",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"main": "./dist/main.js",
	"scripts": {
		"build": "bun build ./src/main.ts --outfile ./dist/main.js --target bun --format esm --minify",
		"dev": "bun run src/main.ts",
		"prepublishOnly": "bun run check && bun run build",
		"typecheck": "tsgo --noEmit",
		"fmt": "oxfmt .",
		"lint": "oxlint",
		"test": "bun test",
		"check": "bun --bun run typecheck && bun --bun run fmt && bun --bun run lint && bun test"
	},
	"dependencies": {
		"@apidevtools/json-schema-ref-parser": "^15.4.0",
		"camelcase": "^9.0.0",
		"openapi-types": "^12.1.3"
	},
	"devDependencies": {
		"@tanstack/react-query": "^5.101.1",
		"@types/bun": "latest",
		"effect": "^4.0.0-beta.86",
		"miniprogram-api-typings": "^5.2.1",
		"oxfmt": "^0.56.0",
		"oxlint": "^1.71.0",
		"typescript": "^7.0.1-rc"
	}
}
