{
	"name": "@puffinstudio/fizzyx",
	"version": "0.4.2",
	"homepage": "https://github.com/PuffinStudio/fizzyx#readme",
	"bugs": {
		"url": "https://github.com/PuffinStudio/fizzyx/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/PuffinStudio/fizzyx.git"
	},
	"bin": {
		"fizzyx": "dist/main.js"
	},
	"type": "module",
	"main": "./dist/main.js",
	"scripts": {
		"build": "bun build ./src/main.ts --outfile ./dist/main.js --target bun --format esm --minify",
		"dev": "bun run src/main.ts",
		"prepublishOnly": "bun run check && bun run build",
		"typecheck": "tsgo --noEmit",
		"fmt": "oxfmt .",
		"lint": "oxlint",
		"test": "bun test",
		"check": "bun --bun run typecheck && bun --bun run fmt && bun --bun run lint && bun test"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@typescript/native-preview": "^7.0.0-dev.20260617.2",
		"effect": "^4.0.0-beta.84",
		"oxfmt": "^0.55.0",
		"oxlint": "^1.70.0"
	}
}
